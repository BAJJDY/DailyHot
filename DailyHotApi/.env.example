# 服务端口
PORT=6688

# 允许的域名（* 表示全部，生产环境建议填具体域名）
ALLOWED_DOMAIN="*"

# 允许的主域名，填写格式为 example.com（填写后忽略 ALLOWED_DOMAIN）
ALLOWED_HOST=""

# ROBOT
DISALLOW_ROBOT=true

# Redis（留空禁用）
REDIS_HOST=""
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# 缓存时长（秒）
CACHE_TTL=3600

# 请求超时（毫秒）
REQUEST_TIMEOUT=15000

# 是否输出日志
USE_LOG_FILE=true

# RSS Mode
RSS_MODE=false

# API Key 鉴权（留空则不启用）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=""

# Weibo
FILTER_WEIBO_ADVERTISEMENT=false
